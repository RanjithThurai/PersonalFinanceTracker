# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Secret (use a strong random string - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration
PORT=5000

# Frontend URL for CORS (update for production deployment)
FRONTEND_URL=http://localhost:3000
